<Window x:Class="CalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator"
        Height="500"
        Width="350">


    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- صفحه نمایش -->
        <TextBox x:Name="txtDisplay"
                 Grid.Row="0"
                 FontSize="35"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"/>



        <!-- دکمه ها -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- ردیف اول -->
            <Button Content="C"
                    Grid.Row="0"
                    Grid.Column="0"
                    Click="Clear_Click"/>

            <Button Content="/"
                    Grid.Row="0"
                    Grid.Column="3"
                    Click="Operator_Click"/>


            <!-- اعداد -->

            <Button Content="7"
                    Grid.Row="1"
                    Grid.Column="0"
                    Click="Number_Click"/>

            <Button Content="8"
                    Grid.Row="1"
                    Grid.Column="1"
                    Click="Number_Click"/>

            <Button Content="9"
                    Grid.Row="1"
                    Grid.Column="2"
                    Click="Number_Click"/>

            <Button Content="*"
                    Grid.Row="1"
                    Grid.Column="3"
                    Click="Operator_Click"/>



            <Button Content="4"
                    Grid.Row="2"
                    Grid.Column="0"
                    Click="Number_Click"/>

            <Button Content="5"
                    Grid.Row="2"
                    Grid.Column="1"
                    Click="Number_Click"/>

            <Button Content="6"
                    Grid.Row="2"
                    Grid.Column="2"
                    Click="Number_Click"/>

            <Button Content="-"
                    Grid.Row="2"
                    Grid.Column="3"
                    Click="Operator_Click"/>



            <Button Content="1"
                    Grid.Row="3"
                    Grid.Column="0"
                    Click="Number_Click"/>

            <Button Content="2"
                    Grid.Row="3"
                    Grid.Column="1"
                    Click="Number_Click"/>

            <Button Content="3"
                    Grid.Row="3"
                    Grid.Column="2"
                    Click="Number_Click"/>

            <Button Content="+"
                    Grid.Row="3"
                    Grid.Column="3"
                    Click="Operator_Click"/>



            <Button Content="0"
                    Grid.Row="4"
                    Grid.Column="0"
                    Click="Number_Click"/>

            <Button Content="="
                    Grid.Row="4"
                    Grid.Column="3"
                    Click="Equal_Click"/>


        </Grid>


    </Grid>

</Window>